# Copie para .env.local e preencha com os dados do projeto no Supabase.
# .env.local não vai para o Git.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role
# IGNORA a RLS. Só o seed e os testes usam. Nunca chega ao navegador,
# nunca entra numa página ou Server Action.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database → Connection string → URI
# Usada só por `npm run db:aplicar`.
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# Base do link enviado por e-mail. Em produção, a URL da Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
